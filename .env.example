# Syed Aboobakar Kedai - Environment Configuration

# Server Port
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# Frontend Client URL (For CORS in development)
CLIENT_URL=http://localhost:3000

# JWT Session Secret Key (Generate a 64+ char random string for production)
JWT_SECRET=syed-aboobakar-kedai-super-secret-key-2026-production-ready

# Database File Path (Default: server/data/grocery.db)
DATABASE_PATH=server/data/grocery.db

# Optional Billplz FPX Malaysia Online Payment (DISABLED BY DEFAULT)
# To enable, register at billplz.com, obtain API credentials, and toggle in Seller Settings.
BILLPLZ_ENABLED=false
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=

# Optional SMTP Email Service (DISABLED BY DEFAULT)
# To enable, configure your SMTP server and toggle in Seller Settings.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@syedaboobakarkedai.com
